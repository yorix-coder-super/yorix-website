# Public build-time overrides for the subscription storefront (no secrets here).
# Defaults live in app/premium/config.ts (Firebase web app «yorix-app.com» of project yorix-app);
# set these only to point a preview at another Firebase web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=yorix-app.firebaseapp.com
# Yorix worker that owns orders and entitlements.
NEXT_PUBLIC_YORIX_API=https://babysleepcoach-ai-proxy.babysleepcoach.workers.dev
