# Public build-time configuration of the Premium storefront (no secrets here).
# Firebase web app of project yorix-app — values from Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=yorix-app.firebaseapp.com
# Yorix worker that owns orders and entitlements.
NEXT_PUBLIC_YORIX_API=https://babysleepcoach-ai-proxy.babysleepcoach.workers.dev
