--- yorix-edge.conf
+++ yorix-edge.conf
@@ -68,12 +68,13 @@
         include /etc/nginx/snippets/yorix-proxy.conf;
         proxy_set_header Connection "";
         proxy_cache yorix;
-        proxy_cache_key $origin$request_uri;
+        proxy_cache_key "$origin$request_uri|encoding-v2:$http_accept_encoding";
         proxy_ignore_headers Cache-Control Expires Set-Cookie;
         proxy_cache_valid 200 7d;
         proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
         proxy_cache_lock on;
         add_header X-Edge-Cache $upstream_cache_status always;
+        add_header Vary Accept-Encoding always;
         proxy_pass https://$origin;
     }
 
@@ -84,12 +85,13 @@
         include /etc/nginx/snippets/yorix-proxy.conf;
         proxy_set_header Connection "";
         proxy_cache yorix;
-        proxy_cache_key $origin$request_uri;
+        proxy_cache_key "$origin$request_uri|encoding-v2:$http_accept_encoding";
         proxy_ignore_headers Cache-Control Expires Set-Cookie;
         proxy_cache_valid 200 301 10m;
         proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
         proxy_cache_lock on;
         add_header X-Edge-Cache $upstream_cache_status always;
+        add_header Vary Accept-Encoding always;
         proxy_pass https://$origin;
     }
 }
